# syntax=docker/dockerfile:1

FROM docker.io/gentoo/portage:latest@sha256:c5b4aa221cc3a65e331407022d5e515363ae0166bb0918e02809cc8e22441dd9 AS portage

FROM docker.io/gentoo/stage3:latest@sha256:08914e15d306bfdb251262ca3f7e3489b77ca32604ad1928cbb21dc94587261c

LABEL org.opencontainers.image.source="https://github.com/jkxyz/ebuilds"

# The full Portage tree is needed while resolving and installing the tools, but
# keeping it as a build mount prevents all Gentoo ebuild sources from entering
# the published image.
RUN --mount=type=bind,from=portage,source=/var/db/repos/gentoo,target=/var/db/repos/gentoo,ro \
    USE="text" emerge --getbinpkg --jobs=2 --oneshot \
        app-portage/gentoolkit \
        app-portage/mgorny-dev-scripts \
        dev-util/pkgcheck \
        dev-util/pkgdev \
        dev-vcs/git \
    && rm -rf /var/cache/distfiles/* /var/cache/binpkgs/*

# pkgcore needs the Gentoo master repository's metadata at runtime, but its
# package ebuild sources are not needed for this overlay's targeted checks.
COPY --from=portage /var/db/repos/gentoo/eclass /var/db/repos/gentoo/eclass
COPY --from=portage /var/db/repos/gentoo/licenses /var/db/repos/gentoo/licenses
COPY --from=portage /var/db/repos/gentoo/metadata /var/db/repos/gentoo/metadata
COPY --from=portage /var/db/repos/gentoo/profiles /var/db/repos/gentoo/profiles

WORKDIR /var/db/repos/jkxyz-ebuilds
