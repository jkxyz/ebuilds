EAPI=8

NEED_EMACS=28.1
ZIG_SLOT=0.17
ZIG_NEEDS_LLVM=1

# Generated by update.py from upstream for offline compilation.
declare -A ZBS_DEPENDENCIES=(
	[aro-d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b.tar.gz]="https://deps.files.ghostty.org/aro-d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b.tar.gz"
	[highway-66486a10623fa0d72fe91260f96c892e41aceb06.tar.gz]="https://deps.files.ghostty.org/highway-66486a10623fa0d72fe91260f96c892e41aceb06.tar.gz"
	[libghostty-vt-1.0.0.tar.gz]="https://release.files.ghostty.org/libghostty-vt/1.0.0/libghostty-vt-1.0.0.tar.gz"
	[translate_c-02ff0c523fb92a38939b04d0145c4a9602a74d56.tar.gz]="https://deps.files.ghostty.org/translate_c-02ff0c523fb92a38939b04d0145c4a9602a74d56.tar.gz"
	[uucode-1fb73433bba5d93366c57f23ff2e9d7939746500.tar.gz]="https://deps.files.ghostty.org/uucode-1fb73433bba5d93366c57f23ff2e9d7939746500.tar.gz"
	[wuffs-7411f488fe2e2c205c3d3b3d28638b7356522930.tar.gz]="https://deps.files.ghostty.org/wuffs-7411f488fe2e2c205c3d3b3d28638b7356522930.tar.gz"
)

inherit elisp zig

DESCRIPTION="Emacs terminal emulator powered by libghostty"
HOMEPAGE="https://github.com/dakra/ghostel/"
SRC_URI="https://github.com/dakra/ghostel/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${ZBS_DEPENDENCIES_SRC_URI}"

LICENSE="GPL-3+ MIT Apache-2.0 BSD ZLIB Unicode-3.0 CC0-1.0"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="test"
RESTRICT="!test? ( test )"

RDEPEND="
	>=app-editors/emacs-${NEED_EMACS}:*[dynamic-loading]
	>=app-emacs/compat-30.1.0.1
"
BDEPEND="${RDEPEND}"

DOCS=( README.md CHANGELOG.md )
SITEFILE="50${PN}-gentoo.el"

pkg_setup() {
	elisp_pkg_setup
	zig_pkg_setup
}

src_configure() {
	local my_zbs_args=(
		# Match upstream; ReleaseSafe translation fails on fortified glibc headers.
		--release=fast
		--prefix "${EPREFIX}/usr/$(get_libdir)/emacs/modules/${PN}"
		# Zig 0.17.1 rejects absolute package paths for nested dependencies.
		--pkg-dir "$(realpath --relative-to="${BUILD_DIR}" "${ZIG_LOCAL_PKG_DIR}")"
	)
	zig_src_configure
}

src_compile() {
	zig_src_compile
	cd lisp || die
	BYTECOMPFLAGS+=" -L ${BROOT}${SITELISP}/compat"
	elisp-compile *.el
	elisp-make-autoload-file "${PN}-autoloads.el" .
}

src_install() {
	zig_src_install
	elisp-install ${PN} lisp/*.el lisp/*.elc
	insinto "${SITEETC}/${PN}"
	doins -r etc
	# Ghostel locates resources relative to its Lisp directory.
	dosym -r "${SITEETC}/${PN}/etc" "${SITELISP}/${PN}/etc"
	sed "s/@VERSION@/${PV//./ }/g" "${FILESDIR}/${SITEFILE}" > "${T}/${SITEFILE}" || die
	elisp-site-file-install "${T}/${SITEFILE}"
}
