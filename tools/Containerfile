# syntax=docker/dockerfile:1

# Repository metadata is mounted only while installing tools; update runs supply a fresh rsync volume.
# The pinned stage3 already includes Portage's verified-rsync runtime and Gentoo release keys.
FROM docker.io/gentoo/portage:latest@sha256:daf0572af8e40096591cf6c9ff9dc15293625582c93a165410f1e8d3090e5cd6 AS portage

FROM docker.io/gentoo/stage3:latest@sha256:dff1d25c6f9066d835b2785fb524b88155d9b3071f1a9968930d70696ab4fdb8

LABEL org.opencontainers.image.source="https://github.com/jkxyz/ebuilds"

COPY tools/gentoo.conf /etc/portage/repos.conf

RUN --mount=type=bind,from=portage,source=/var/db/repos/gentoo,target=/var/db/repos/gentoo \
    USE="text" emerge --getbinpkg --jobs=2 --oneshot \
        app-portage/gentoolkit \
        app-portage/mgorny-dev-scripts \
        dev-util/pkgcheck \
        dev-util/pkgdev \
        dev-vcs/git \
    && rm -rf /var/cache/distfiles/* /var/cache/binpkgs/*

WORKDIR /var/db/repos/jkxyz-ebuilds
